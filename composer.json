{
    "name": "comunedifirenze/user-bundle",
    "type": "symfony-bundle",
    "description": "Comune di Firenze Symfony UserBundle",
    "homepage": "https://github.com/ComuneFI",
    "license": "MIT",
    "authors": [
        {
            "name": "Christophe Coevoet",
            "email": "stof@notk.org"
        },
        {
            "name": "Thibault Duplessis"
        },
        {
            "name": "FriendsOfSymfony Community",
            "homepage": "https://github.com/friendsofsymfony/FOSUserBundle/contributors"
        },
        {
            "name": "Kevin Papst",
            "homepage": "https://www.kevinpapst.de"
        },
        {
            "name": "Andrea Manzi",
            "homepage": "https://github.com/manzolo"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/dependency-injection": "^6.4",
        "symfony/form": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/http-kernel": "^6.4",
        "symfony/mailer": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/security-bundle": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/validator": "^6.4",
        "doctrine/orm": "^2.0",
        "doctrine/doctrine-bundle": "^2.15",
        "doctrine/doctrine-migrations-bundle": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "symfony/console": "^6.4",
        "symfony/maker-bundle": "^1.54",
        "symfony/yaml": "^6.4"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "FOS\\UserBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FOS\\UserBundle\\Tests\\": "/Tests/"
        }
    },
    "_comment" : "rector/rector: ^2.4"
}

