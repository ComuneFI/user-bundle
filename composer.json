{
    "name": "comunedifirenze/user-bundle",
    "type": "symfony-bundle",
    "description": "Comune di Firenze Symfony UserBundle",
    "homepage": "https://github.com/ComuneFI",
    "license": "MIT",
    "authors": [
        {
            "name": "Christophe Coevoet",
            "email": "stof@notk.org"
        },
        {
            "name": "Thibault Duplessis"
        },
        {
            "name": "FriendsOfSymfony Community",
            "homepage": "https://github.com/friendsofsymfony/FOSUserBundle/contributors"
        },
        {
            "name": "Kevin Papst",
            "homepage": "https://www.kevinpapst.de"
        },
        {
            "name": "Andrea Manzi",
            "homepage": "https://github.com/manzolo"
        }
    ],
    "require": {
        "php": ">=8.2",
        "paragonie/random_compat": "^1 || ^2 || ^9",
        "symfony/form": "6.4.*",
        "symfony/framework-bundle": "^6.4",
        "symfony/mailer": "^6.4",
        "symfony/security-bundle": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/validator": "^6.4"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.0",
        "phpunit/phpunit": "^10.0",
        "symfony/console": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "FOS\\UserBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FOS\\UserBundle\\Tests\\": "/Tests/"
        }
    }
}
